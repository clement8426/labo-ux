{
  "compilerOptions": {
    "target": "ES2023", "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "noUncheckedIndexedAccess": true, "esModuleInterop": true,
    "rootDir": ".", "outDir": "dist", "declaration": true, "sourceMap": true,
    "skipLibCheck": true, "types": ["node"]
  },
  "include": ["packages/**/*.ts"], "exclude": ["node_modules", "dist"]
}
